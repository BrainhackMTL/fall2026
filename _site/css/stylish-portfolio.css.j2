    -webkit-background-size: cover;
    -moz-background-size: cover;
    background-size: cover;
    -o-background-size: cover;
}

.schedule-layout {
    margin: 30px 0 40px;
}

.schedule-day-tabs {
    display: none;
}

.schedule-panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.schedule-day {
    min-width: 0;
    padding: 20px;
    background: rgba(4, 24, 38, .62);
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
}

.schedule-day-tutorials {
    grid-column: 1 / -1;
}

.schedule-day-title,
.tutorial-track-title {
    margin: 0;
    text-align: center;
}

.schedule-day-title {
    margin-bottom: 18px;
}

.schedule-day-summary {
    margin: -8px 0 18px;
    text-align: center;
}

.tutorial-tracks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
}

.tutorial-track {
    min-width: 0;
    padding: 18px;
    background: rgba(0, 0, 0, .22);
    border-radius: 8px;
}

.tutorial-track-title {
    margin-bottom: 12px;
    font-size: 16px;
}

.schedule-entry {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 6px 0;
}

.schedule-time {
    font-weight: 700;
    white-space: nowrap;
}

@media (max-width: 991px) {
    .schedule-panels {
        grid-template-columns: 1fr;
    }

    .schedule-day-tutorials {
        grid-column: auto;
    }
}

@media (max-width: 767px) {
    .workspace {
        height: auto;
        padding-bottom: 8px;
    }

    .schedule-layout {
        margin-top: 20px;
    }

    .js .schedule-day-tabs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 4px;
        margin-bottom: 16px;
        padding: 4px;
        background: rgba(4, 24, 38, .62);
        border: 1px solid rgba(255, 255, 255, .28);
        border-radius: 10px;
    }

    .schedule-day-tab {
        display: flex;
        min-width: 0;
        min-height: 52px;
        padding: 7px 3px;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 2px;
        color: {{color_theme.font}};
        background: transparent;
        border: 0;
        border-radius: 7px;
        font: inherit;
        line-height: 1.2;
    }

    .schedule-day-tab:hover,
    .schedule-day-tab:focus {
        color: {{color_theme.font}};
        background: rgba(255, 255, 255, .12);
    }

    .schedule-day-tab.is-selected,
    .schedule-day-tab.is-selected:hover,
    .schedule-day-tab.is-selected:focus {
        color: {{color_theme.primary}};
        background: {{color_theme.font}};
        box-shadow: 0 2px 8px rgba(0, 0, 0, .2);
    }

    .schedule-day-tab:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 2px;
    }

    .schedule-tab-day {
        font-size: 12px;
        font-weight: 700;
    }

    .schedule-tab-date {
        font-size: 10px;
        white-space: nowrap;
    }

    .schedule-panels {
        display: block;
    }

    .js .schedule-day:not(.is-selected) {
        display: none;
    }

    .tutorial-tracks {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .schedule-day {
        padding: 16px;
    }

    .tutorial-track {
        padding: 14px;
    }

    .schedule-entry {
        grid-template-columns: 1fr;
        gap: 2px;
        padding: 7px 0;
    }

    .schedule-time {
        font-size: .9em;
        opacity: .82;
    }
}

.hotel {
