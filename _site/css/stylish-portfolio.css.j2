/* Global Styles */

html {
    width: 100%;
    height: 100%;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 86px;
}

body {
    min-height: 100%;
    font-family: "Source Sans Pro","Helvetica Neue",Helvetica,Arial,sans-serif;
}

.skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 1100;
    padding: 10px 14px;
    color: #062238;
    background: #fff;
    border: 2px solid {{color_theme.primary}};
    border-radius: 6px;
    transform: translateY(-150%);
    transition: transform .2s ease;
}

.skip-link:focus {
    color: #062238;
    transform: translateY(0);
}

/* Sticky navigation */

.site-nav {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 1000;
    min-height: 72px;
    color: #fff;
    background: rgba(0, 60, 96, 0.88);
    border-bottom: 1px solid rgba(255, 255, 255, .14);
    box-shadow: 0 8px 24px rgba(0, 63, 101, .2);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    font-family: 'Comfortaa', cursive;
}

.site-nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
}

.site-nav a,
.site-nav a:hover,
.site-nav a:focus {
    color: #fff;
    border-bottom: 0;
    text-decoration: none;
}

.site-nav-brand {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    flex: 0 0 auto;
    font-size: 16px;
    letter-spacing: -.02em;
}

.site-nav-logo {
    display: block;
    width: 52px;
    height: 52px;
    object-fit: contain;
}

.site-nav-links {
    display: flex;
    gap: 4px;
    align-items: center;
}

.site-nav-links a {
    position: relative;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    transition: color .2s ease, background-color .2s ease;
}

.site-nav-links a:hover,
.site-nav-links a:focus,
.site-nav-links a.is-active {
    color: #fff;
    background: rgba(255, 255, 255, .13);
}

.site-nav-links a.is-active::after {
    position: absolute;
    right: 12px;
    bottom: 4px;
    left: 12px;
    height: 2px;
    content: '';
    background: #fff;
    border-radius: 2px;
}

.site-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, .34);
    border-radius: 7px;
}

.site-nav-toggle:hover,
.site-nav-toggle:focus,
.site-nav-toggle.is-open {
    background: rgba(255, 255, 255, .12);
    outline: none;
}

.site-nav-toggle:focus-visible,
.site-nav a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
}

.site-nav-toggle-line {
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform .2s ease, opacity .2s ease;
}

.site-nav-toggle.is-open .site-nav-toggle-line:nth-of-type(2) {
    transform: translateY(7px) rotate(45deg);
}

.site-nav-toggle.is-open .site-nav-toggle-line:nth-of-type(3) {
    opacity: 0;
}

.site-nav-toggle.is-open .site-nav-toggle-line:nth-of-type(4) {
    transform: translateY(-7px) rotate(-45deg);
}

.hl {
    font-weight: bold;
    color: {{color_theme.primary}};
}

.text-color-blue {
	color:{{color_theme.primary}};
}
.text-color-blue a {
	color:{{color_theme.primary}};
}

/* Custom Button Styles */

.btn-dark {
    border-radius: 4;
    color: {{color_theme.font}};
    background-color: {{color_theme.primary}};
}

.btn-dark:hover,
.btn-dark:focus,
.btn-dark:active {
    color: {{color_theme.font}};
    background-color: {{color_theme.primary_hover}};
}

.btn-light {
    border-radius: 0;
    color: #333;
    background-color: rgb(255,255,255);
}

.btn-light:hover,
.btn-light:focus,
.btn-light:active {
    color: #333;
    background-color: rgba(255,255,255,0.8);
}

/* Custom Horizontal Rule */

hr.small {
    max-width: 100px;
}

/* Header */

.header {
    display: table;
    position: relative;
    width: 100%;
    height: calc(100vh - 72px);
    min-height: 600px;
    box-shadow: inset 0 0 0 1000px rgba(0,0,0,.4);
    background: url({{background_img | relative_url("css")}}) no-repeat center center scroll;
    -webkit-background-size: cover;
    -moz-background-size: cover;
    background-size: cover;
    -o-background-size: cover;
}

.header .row {
    margin-right: 0;
    margin-left: 0;
}

.text-vertical-center {
    display: table-cell;
    text-align: center;
    vertical-align: middle;
    color: {{color_theme.font}};
    font-family: 'Comfortaa', cursive;
}

.text-vertical-center h1 {
    margin: 0;
    padding: 0;
    font-size: 4.5em;
    font-weight: 700;
}

.hero-sponsors {
    margin: 26px auto 0;
    padding: 0 20px;
}

.hero-sponsors-title {
    margin: 0 0 10px;
    font-size: 1.15em;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1.2;
    text-transform: uppercase;
}

.hero-sponsor-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
}

.hero-sponsor-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 110px;
    height: 110px;
    padding: 9px 14px;
    overflow: hidden;
    background: #fff;
    border: 2px solid transparent;
    border-radius: 2px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, .2);
    transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
}

.hero-sponsor-link:hover,
.hero-sponsor-link:focus {
    background: #fff;
    border-color: {{color_theme.primary_hover}};
    outline: none;
    transform: translateY(-2px);
}

.hero-sponsor-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
}

.hero-sponsor-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 30px auto 0;
    padding: 0 20px;
}

.hero-actions .btn {
    margin: 0;
}

@media (max-width: 767px) {
    html {
        scroll-padding-top: 74px;
    }

    .site-nav,
    .site-nav-inner {
        min-height: 64px;
    }

    .site-nav-inner {
        flex-wrap: wrap;
        width: 100%;
        padding-right: 16px;
        padding-left: 16px;
    }

    .site-nav-brand {
        font-size: 15px;
    }

    .site-nav-logo {
        width: 44px;
        height: 44px;
    }

    .js .site-nav-toggle {
        display: inline-flex;
    }

    .site-nav-links {
        width: 100%;
        padding: 8px 0 14px;
        border-top: 1px solid rgba(255, 255, 255, .12);
    }

    .js .site-nav-links {
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        display: none;
        max-height: calc(100vh - 64px);
        overflow-y: auto;
        background: rgba(0, 103, 165, .96);
        box-shadow: 0 16px 26px rgba(0, 63, 101, .26);
    }

    .js .site-nav-links.is-open {
        display: flex;
        align-items: stretch;
        flex-direction: column;
    }

    .site-nav-links a {
        padding: 13px 18px;
        border-radius: 0;
        font-size: 14px;
    }

    .site-nav-links a.is-active::after {
        top: 12px;
        right: auto;
        bottom: 12px;
        left: 7px;
        width: 3px;
        height: auto;
    }

    .header {
        height: auto;
        min-height: calc(100vh - 64px);
        padding: 48px 0;
        background-attachment: scroll;
    }

    .text-vertical-center h1 {
        padding: 0 15px;
        font-size: 2.8em;
        line-height: 1.12;
    }

    .text-vertical-center h2 {
        font-size: 1.35em;
        line-height: 1.35;
    }

    .hero-sponsors {
        margin-top: 22px;
        padding: 0 12px;
    }

    .hero-sponsors-title {
        font-size: 1em;
    }

    .hero-sponsor-list {
        gap: 6px;
    }

    .hero-sponsor-link {
        width: 94px;
        height: 94px;
        padding: 6px 8px;
    }

    .hero-actions {
        align-items: stretch;
        flex-direction: column;
        max-width: 390px;
        margin-top: 24px;
    }

    .hero-actions .btn {
        white-space: normal;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    .site-nav-toggle-line,
    .site-nav-links a,
    .hero-sponsor-link,
    .skip-link {
        transition: none;
    }
}

