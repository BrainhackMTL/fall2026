}

/* Foldable project listing */

.submitted-projects {
    max-width: 980px;
    margin: 28px auto 0;
    overflow: hidden;
    color: #123247;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: 10px;
    box-shadow: 0 12px 30px rgba(0, 49, 79, .2);
    text-align: left;
}

.submitted-projects > summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 14px;
    align-items: center;
    padding: 22px 26px;
    color: #064f7d;
    cursor: pointer;
    list-style: none;
}

.submitted-projects > summary::-webkit-details-marker {
    display: none;
}

.submitted-projects > summary:hover {
    background: #f1f7f9;
}

.submitted-projects > summary:focus-visible {
    outline: 3px solid #76b900;
    outline-offset: -4px;
}

.submitted-projects-title {
    font-size: 20px;
    font-weight: 700;
}

.submitted-projects-title .fa-brands {
    margin-right: 8px;
}

.submitted-projects-count {
    padding: 5px 10px;
    color: #294958;
    background: #e7f0f4;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
}

.submitted-projects-chevron {
    transition: transform .2s ease;
}

.submitted-projects[open] .submitted-projects-chevron {
    transform: rotate(180deg);
}

.submitted-projects[open] > summary {
    border-bottom: 1px solid #dce7ed;
}

.submitted-projects-content {
    padding: 26px;
}

.submitted-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.submitted-project-card {
    display: flex;
    min-width: 0;
    padding: 22px;
    flex-direction: column;
    background: #f7fafb;
    border: 1px solid #dce7ed;
    border-top: 4px solid {{color_theme.primary}};
    border-radius: 8px;
}

.submitted-project-card h3 {
    margin: 0 0 14px;
    color: #064f7d;
    font-size: 20px;
    line-height: 1.35;
}

.submitted-project-leaders {
    color: #294958;
    font-size: 14px;
}

.submitted-project-leaders .fa-solid {
    margin-right: 5px;
    color: {{color_theme.primary}};
}

.submitted-project-description {
    margin-bottom: 20px;
    color: #3d5664;
    line-height: 1.55;
}

.submitted-project-link {
    margin-top: auto;
    color: #064f7d !important;
    font-weight: 700;
}

.submitted-project-link:hover,
.submitted-project-link:focus {
    color: #3f6500 !important;
}

.submitted-projects-empty {
    max-width: 660px;
    margin: 0 auto;
    padding: 14px 0 18px;
}

.submitted-projects-empty > .fa-solid {
    color: #76b900;
    font-size: 34px;
}

.submitted-projects-empty h3 {
    margin: 12px 0 8px;
    color: #064f7d;
}

.submitted-projects-empty p {
    margin-bottom: 20px;
    line-height: 1.55;
}

.submitted-projects-empty .btn-dark {
    color: #fff !important;
    text-decoration: none;
}

